AIVA_BACKEND_URL=http://127.0.0.1:3000
# Administrator-selected provider ID; never accepted from User/browser input.
# Leave unset to show an explicit configuration blocker in Chat.
AIVA_CHAT_PROVIDER_ID=
# Set the exact public HTTPS origin behind a reverse proxy in production.
# AIVA_PUBLIC_ORIGIN=https://aiva.example.com
# Only for an explicitly configured HTTP LAN test environment; production defaults to Secure.
# AIVA_COOKIE_SECURE=false
