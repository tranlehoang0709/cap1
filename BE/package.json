{
  "name": "aiva-iot-backend",
  "version": "1.0.0",
  "private": true,
  "description": "AIVA-IoT NestJS backend foundation",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage --coverageReporters=json-summary --coverageReporters=text-summary --coverageDirectory=coverage/sprint2",
    "test:typecheck": "tsc --noEmit --incremental false",
    "test:mysql": "node scripts/run-mysql-integration.cjs",
    "test:quota:mysql": "node scripts/run-mysql-integration.cjs --quota",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/platform-express": "^11.2.5",
    "mysql2": "^3.14.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "jest": "^30.0.5",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
