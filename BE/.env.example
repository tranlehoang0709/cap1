NODE_ENV=development
PORT=3000

# Connect only to the already-provisioned AIVA-IoT V1.5 database.
# Copy this file to .env and fill in credentials locally; never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=aiva_iot
DB_CONNECTION_LIMIT=10

# Generate independent random values of at least 32 characters.
JWT_ACCESS_SECRET=replace_with_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_refresh_secret_at_least_32_chars
APP_ENCRYPTION_KEY=replace_with_32_byte_base64url_key_generated_locally
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Comma-separated exact frontend origins. Leave empty to disable browser CORS.
CORS_ORIGINS=http://localhost:8501

# Bootstrap Admin is created only when this email does not already exist.
ADMIN_EMAIL=admin@example.test
ADMIN_PASSWORD=replace_with_a_strong_admin_password
ADMIN_DISPLAY_NAME=System Administrator

# Internal AI_SERVER contracts are OFF until deployment/operator approval.
# Generate three INDEPENDENT base64url values (43-128 chars); never use JWT keys.
# Use TLS at the trusted ingress. HTTP loopback is for local development only.
DEVICE_AUTH_CONTRACT_APPROVED=false
AI_CONFIG_CONTRACT_APPROVED=false
AI_QUOTA_CONTRACT_APPROVED=false
# AI_DEVICE_SERVICE_TOKEN=
# AI_CONFIG_SERVICE_TOKEN=
# AI_QUOTA_SERVICE_TOKEN=
# Required when enabling quota admission or its report sweeper. No runtime default.
# AI_USAGE_REPORT_TIMEOUT_SECONDS=30
AI_USAGE_REPORT_SWEEPER_ENABLED=false
HEARTBEAT_TIMEOUT_SECONDS=60

# SYSTEM credential use requires explicit user selection AND an allowlist.
AI_SYSTEM_CREDENTIAL_ALLOWED_USER_IDS=
# Optional context-bound five-part credential envelope; legacy /api-keys uses
# APP_ENCRYPTION_KEY above. Never convert credentialReference into a raw key.
# AI_SECRET_KEY_BASE64=32_byte_standard_base64_value
# AI_SECRET_KEY_ID=local-v1

# New Admin quota routes accept current login access JWTs by default.
# Optional legacy verifier: configure ALL THREE only if intentionally required.
# ADMIN_ACCESS_JWT_SECRET=
# ADMIN_ACCESS_JWT_ISSUER=
# ADMIN_ACCESS_JWT_AUDIENCE=
# Internal Web Chat executor. HTTP is allowed only on loopback; otherwise HTTPS.
AI_SERVER_URL=http://127.0.0.1:8000
AI_SERVER_WEB_TOKEN=

# Explicit operator-only local TTY delivery; production mail transport is not configured.
EMAIL_VERIFICATION_DELIVERY=disabled
EMAIL_VERIFICATION_FRONTEND_URL=http://127.0.0.1:8513
