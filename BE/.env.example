NODE_ENV=development
PORT=3000

# Connect only to the already-provisioned AIVA-IoT V1.5 database.
# Copy this file to .env and fill in credentials locally; never commit .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=aiva_iot
DB_CONNECTION_LIMIT=10

# Access-token verification for Admin Device APIs (no token issuing endpoint yet).
# Set a random secret of at least 32 bytes locally; coordinate with the auth issuer.
ADMIN_ACCESS_JWT_SECRET=
ADMIN_ACCESS_JWT_ISSUER=aiva-backend
ADMIN_ACCESS_JWT_AUDIENCE=aiva-admin

# Internal device auth is BLOCKED until AI Server/Firmware agree on the contract.
DEVICE_AUTH_CONTRACT_APPROVED=false
# Separate random 32-byte base64url service token (43 characters minimum). Never reuse JWT secret.
AI_DEVICE_SERVICE_TOKEN=

# AES-256-GCM: provision a random 32-byte key encoded in base64; never commit it.
AI_SECRET_KEY_BASE64=
AI_SECRET_KEY_ID=primary
# Explicit SYSTEM-key permission; comma-separated canonical User IDs. Empty denies all.
AI_SYSTEM_CREDENTIAL_ALLOWED_USER_IDS=
# Reference-only internal config contract; raw key delivery is not implemented.
AI_CONFIG_CONTRACT_APPROVED=false
AI_CONFIG_SERVICE_TOKEN=

# Approved presence timeout: 60 seconds (Prompt 5). Sweep cadence equals timeout.
HEARTBEAT_TIMEOUT_SECONDS=60
HEARTBEAT_SWEEPER_ENABLED=true

# Recovery storage must be provisioned/private/durable; reuse AI_SECRET_KEY_* encryption.
RECOVERY_STORAGE_APPROVED=false
RECOVERY_BACKUP_DIRECTORY=
# Independent management channel: reset must work after device credentials are revoked.
RESET_CONTRACT_APPROVED=false
DEVICE_RESET_SERVICE_TOKEN=
# Explicit reset delivery retry lease; configure after contract agreement, no invented default.
DEVICE_RESET_RETRY_SECONDS=

# Quota: migration must be applied separately before these APIs become operational.
AI_QUOTA_CONTRACT_APPROVED=false
AI_QUOTA_SERVICE_TOKEN=
# Required deadline, no numeric default. Missing reports retain reservations.
AI_USAGE_REPORT_TIMEOUT_SECONDS=
AI_USAGE_REPORT_SWEEPER_ENABLED=false
