# Copy to .env.test; use a preprovisioned isolated V1.5 schema only.
# These are placeholders. No tables/databases are created by the test runner.
NODE_ENV=test
MYSQL_INTEGRATION_TESTS=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_test_only_mysql_user
DB_PASSWORD=replace_locally
DB_NAME=aiva_iot_test
DB_CONNECTION_LIMIT=10
HEARTBEAT_SWEEPER_ENABLED=false
JWT_ACCESS_SECRET=replace_with_test_only_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_independent_test_refresh_secret_at_least_32_chars
APP_ENCRYPTION_KEY=replace_with_32_byte_base64url_key_43_chars
ADMIN_EMAIL=fixture-admin@example.test
ADMIN_PASSWORD=replace_with_test_only_password
ADMIN_DISPLAY_NAME=Fixture Admin
# Test process generates its own in-memory signing/encryption/service secrets and
# temporary backup directory. Never copy production secrets into the test fixture.
