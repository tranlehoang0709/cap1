# Copy to .env.local (ignored); use the key configured on your llama-server.
AI_RUNTIME=local
LOCAL_LLM_BASE_URL=http://127.0.0.1:8001/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_CHAT_TOKEN=
LOCAL_LLM_TIMEOUT_SECONDS=90
LOCAL_LLM_CONNECT_TIMEOUT_SECONDS=5
LOCAL_LLM_MAX_RETRIES=1
LOCAL_LLM_MAX_OUTPUT_TOKENS=256
LOCAL_LLM_MAX_OUTPUT_CHARS=8000
LOCAL_LLM_MAX_CONTEXT_TOKENS=8192
LOCAL_STT_ENGINE=faster-whisper
LOCAL_STT_MODEL=Systran/faster-whisper-small
LOCAL_STT_CACHE_DIR=C:\Users\troc\.cache\huggingface\hub
LOCAL_STT_DEVICE=cuda
LOCAL_STT_COMPUTE_TYPE=float16
LOCAL_STT_LANGUAGE=vi
LOCAL_STT_TIMEOUT_SECONDS=30
LOCAL_STT_VAD_MIN_SILENCE_MS=2000
LOCAL_TTS_MODEL_PATH=C:\Users\troc\.cache\aiva-iot\piper\vi_VN-vais1000-medium.onnx
LOCAL_TTS_CONFIG_PATH=C:\Users\troc\.cache\aiva-iot\piper\vi_VN-vais1000-medium.onnx.json
