# Integrated mode is the safe default. Supply Backend service tokens before startup.
AI_SERVER_HOST=127.0.0.1
AI_SERVER_PORT=8000
AI_SERVER_BACKEND_MODE=integrated
AI_SERVER_BACKEND_URL=http://127.0.0.1:3000
AI_SERVER_BACKEND_ALLOW_LOCAL_HTTP=true
AI_SERVER_BACKEND_TIMEOUT_SECONDS=5
AI_SERVER_BACKEND_MAX_CONNECTIONS=10
AI_SERVER_BACKEND_MAX_RESPONSE_BYTES=65536
# Set independent base64url service tokens (43-128 characters) in the environment.
AI_SERVER_BACKEND_DEVICE_TOKEN=
AI_SERVER_BACKEND_CONFIG_TOKEN=
AI_SERVER_BACKEND_QUOTA_TOKEN=
AI_SERVER_LOG_LEVEL=warning
AI_SERVER_RELOAD=true
# Complete message payload in UTF-8 bytes, including all fragments; maximum 4096.
AI_SERVER_WS_MAX_MESSAGE_BYTES=4096
# Optional absolute path to native libopus (for Windows DLL installations).
AI_SERVER_OPUS_LIBRARY=
# Robot gateway AI path: mock (default) or explicit Gemini live providers.
# Gemini is development-only and still requires AI_SERVER_BACKEND_MODE=development-mock,
# Backend service is not bypassed in integrated mode.
AI_SERVER_ROBOT_AI_MODE=mock
# Read from .env as well as the process environment. Enable only for private LAN tests.
AI_SERVER_ROBOT_ENABLED=false
AI_SERVER_ROBOT_TOKEN=
AI_SERVER_ROBOT_ALLOWED_NETWORKS=["127.0.0.0/8","::1/128"]
AI_SERVER_ROBOT_ENERGY_THRESHOLD=300
AI_SERVER_ROBOT_DEADLINE_SECONDS=90
AI_SERVER_ROBOT_MAX_SESSIONS=2
AI_SERVER_ROBOT_MAX_OUTPUT_AUDIO_BYTES=5000000
AI_SERVER_ROBOT_MAX_TOTAL_AUDIO_MEMORY_BYTES=256000000
# Development mocks require explicit AI_SERVER_BACKEND_MODE=development-mock.
AI_SERVER_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_TIMEOUT_SECONDS=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=30
# Gemini 3.8 TTS: Free Tier is listed by Google; requests still obey Google rate limits.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
GEMINI_TTS_TIMEOUT_SECONDS=30
GEMINI_TTS_MAX_TEXT_CHARS=2000
# Standalone live LLM+TTS demo requires explicit opt-in; not Backend authenticated/quota admitted.
AI_SERVER_VOICE_DEMO_ENABLE=false
AI_SERVER_VOICE_DEMO_OUTPUT=artifacts/gemini_voice_demo.wav
# Interactive keyboard -> Gemini LLM/TTS diagnostic; additionally requires --enable.
AI_SERVER_INTERACTIVE_VOICE_DEMO_ENABLE=false
# Live latency benchmark (5-10 real turns per question class); additionally requires --enable.
AI_SERVER_GEMINI_BENCHMARK_ENABLE=false
AI_SERVER_GEMINI_TTS_STREAM_TEST_ENABLE=false
# Audio remains in RAM by default; WAV export requires explicit --export-audio on a demo.
# File-based STT -> LLM -> TTS diagnostic has a separate opt-in.
AI_SERVER_VOICE_PIPELINE_DEMO_ENABLE=false

# Gemini STT: model supports audio input; bounded inline audio and operation deadline.
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_STT_TIMEOUT_SECONDS=30
AI_SERVER_STT_MAX_AUDIO_BYTES=5000000
AI_SERVER_STT_MAX_DURATION_SECONDS=120
